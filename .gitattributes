# Force LF line endings for all scripts - these run on NeSI (Linux)
# Windows checkouts will get CRLF locally but commits always store LF

* text=auto

*.sh    text eol=lf
*.sl    text eol=lf
*.smk   text eol=lf
*.py    text eol=lf
*.R     text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.csv   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf
